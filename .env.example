# Public website URL, for canonical links and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the self-hosted admin API. Use a unique password of at least 8 characters
# and a random secret of at least 32 characters. Keep these values private and out of source control.
ADMIN_PASSWORD=replace-with-a-strong-private-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Free Supabase project settings for member registration and event preferences.
# Copy the Project URL and publishable key from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required only for the server-side admin email dispatch. Never add NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
