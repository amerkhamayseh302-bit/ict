# Public website URL, for canonical links and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the self-hosted admin API. Use a unique password of at least 8 characters
# and a random secret of at least 32 characters. Keep these values private and out of source control.
ADMIN_PASSWORD=replace-with-a-strong-private-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# PostgreSQL database connection URL
# Supports local PostgreSQL, Neon, Railway, Docker, or any standard Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ict_community

# Required only for the server-side admin event email dispatch.
GMAIL_USER=
GMAIL_APP_PASSWORD=
